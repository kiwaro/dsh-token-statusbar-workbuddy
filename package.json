{
  "name": "dsh-token-statusbar-workbuddy",
  "version": "0.1.0",
  "description": "在 DSH 输入框下方显示会话用量，读取 WorkBuddy 响应积分记录，并按会话与模型汇总。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "token-usage",
    "statusbar",
    "context",
    "ttft",
    "workbuddy"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "icon": "icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0"
    },
    "optionalPlugins": [
      {
        "name": "dsh-context",
        "provides": "contextTimeline",
        "reason": "Provides context timing and composition data. When unavailable, the plugin reads sessionStats and contextBreakdown."
      }
    ]
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "WorkBuddy 用量状态栏",
    "summary": "在输入框下方查看会话用量、WorkBuddy 积分、模型费率和账号余额。",
    "category": "usage",
    "surfaces": [
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0",
      "node": ">=22.15"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test tests/accounting.test.mjs tests/host.test.mjs tests/ui-contract.test.mjs tests/migration.test.mjs",
    "check": "npm test && node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiwaro/dsh-token-statusbar-workbuddy.git"
  },
  "homepage": "https://github.com/kiwaro/dsh-token-statusbar-workbuddy#readme",
  "bugs": {
    "url": "https://github.com/kiwaro/dsh-token-statusbar-workbuddy/issues"
  }
}
